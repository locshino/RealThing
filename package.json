{
	"name": "@realthing/monorepo",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@astrojs/check": "0.9.12",
			"@changesets/changelog-github": "1.0.1",
			"@changesets/cli": "3.0.3",
			"@fontsource-variable/geist": "5.3.0",
			"@fontsource-variable/jetbrains-mono": "5.3.0",
			"@fontsource-variable/orbitron": "5.3.0",
			"@remixicon/react": "4.9.0",
			"@tailwindcss/vite": "4.3.3",
			"@types/bun": "1.4.4",
			"@types/react": "19.3.0",
			"@types/react-dom": "19.3.0",
			"astro": "7.3.3",
			"diff": "9.0.0",
			"lucide-react": "1.61.0",
			"mermaid": "12.2.0",
			"react": "19.3.1",
			"react-dom": "19.3.1",
			"react-markdown": "10.1.0",
			"react-virtuoso": "4.18.19",
			"remark-gfm": "4.0.1",
			"resedit": "3.1.0",
			"shiki": "4.5.0",
			"tailwindcss": "4.3.3",
			"typebox": "1.3.27",
			"typescript": "6.0.3"
		}
	},
	"overrides": {
		"dompurify": "3.4.17",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"dev": "bun scripts/dev.ts",
		"dev:server": "turbo run dev --filter=@realthing/server",
		"dev:web": "turbo run dev --filter=@realthing/web",
		"build:web": "turbo run build --filter=@realthing/web",
		"build:binary": "bun run build:web && bun apps/cli/scripts/build-binary.ts",
		"smoke:binary": "bun packages/artifact-tests/smoke-binary.ts",
		"desktop:build": "bun run --cwd apps/desktop package:dev",
		"desktop:dev": "bun run --cwd apps/desktop dev",
		"desktop:package:canary": "bun run --cwd apps/desktop package:canary",
		"desktop:package:stable": "bun run --cwd apps/desktop package:stable",
		"smoke:desktop": "bun packages/artifact-tests/smoke.ts",
		"smoke:desktop:installer": "bun packages/artifact-tests/installerSmoke.ts",
		"typecheck": "turbo run typecheck",
		"test": "bun test ./scripts/ && turbo run test --continue",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepare": "husky",
		"e2e": "bun --preload ./e2e/idleSleepPreload.ts e2e/run.ts",
		"e2e:serial": "bun --preload ./e2e/idleSleepPreload.ts e2e/run.ts --serial",
		"e2e:binary": "bun --preload ./e2e/idleSleepPreload.ts e2e/run-binary.ts",
		"e2e:desktop": "bun --preload ./e2e/idleSleepPreload.ts e2e/run-desktop.ts",
		"test:windows-paths": "bun test --timeout 30000 packages/server/src/host/directorySpelling.test.ts packages/server/src/persistence/storedDirectories.test.ts packages/server/src/projects/projects.test.ts packages/server/src/workspaces/workspaces.test.ts packages/server/src/fs/files.test.ts packages/server/src/git/objectName.test.ts packages/server/src/dialog/dialog.test.ts && bun test packages/artifact-tests/src/installerScripts.test.ts -t install.ps1",
		"e2e:headed": "bun --preload ./e2e/idleSleepPreload.ts e2e/run.ts --headed",
		"e2e:ui": "bun --preload ./e2e/idleSleepPreload.ts e2e/run.ts --ui",
		"perf:render": "bun --preload ./e2e/idleSleepPreload.ts e2e/perf/run.ts",
		"check:deps": "bun scripts/check-catalog.ts",
		"check:boundaries": "bun test scripts/checkModuleBoundaries.test.ts && bun scripts/check-module-boundaries.ts",
		"check:spec-surface": "bun scripts/check-spec-surface.ts",
		"check:i18n": "bun test scripts/checkI18n.test.ts scripts/i18nRenderReach.test.ts && bun scripts/check-i18n.ts",
		"check:compiler": "bun --filter @realthing/web compiler:census:check",
		"ci:flakes": "bun scripts/ci-flakes.ts",
		"changeset": "changeset",
		"release:version": "changeset version && bun install --no-frozen-lockfile",
		"typography:generate": "bun --filter @realthing/web typography:generate",
		"typography:validate": "bun --filter @realthing/web typography:validate",
		"typography:check": "bun --filter @realthing/web typography:check",
		"colors:generate": "bun --filter @realthing/web colors:generate",
		"colors:check": "bun --filter @realthing/web colors:check",
		"spacing:generate": "bun --filter @realthing/web spacing:generate",
		"spacing:check": "bun --filter @realthing/web spacing:check",
		"compiler:census:generate": "bun --filter @realthing/web compiler:census:generate"
	},
	"devDependencies": {
		"@changesets/changelog-github": "catalog:",
		"@changesets/cli": "catalog:",
		"@biomejs/biome": "2.5.0",
		"@realthing/artifact-tests": "workspace:*",
		"@realthing/contracts": "workspace:*",
		"@realthing/server": "workspace:*",
		"@realthing/shared": "workspace:*",
		"@realthing/spec-graph": "workspace:*",
		"@playwright/test": "1.61.0",
		"husky": "9.1.7",
		"mdast-util-from-markdown": "2.1.0",
		"turbo": "2.11.10",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild"
	],
	"patchedDependencies": {
		"@pierre/diffs@1.5.1": "patches/@pierre%2Fdiffs@1.5.1.patch"
	}
}
