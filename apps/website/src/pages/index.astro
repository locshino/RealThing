---
import BaseHead from "../components/BaseHead.astro";
import CliInstall from "../components/CliInstall.astro";
import IdeShell from "../components/IdeShell.astro";
import { heroDownloadTarget } from "../heroDownload";
import { desktopInstallerPlatforms } from "../installCommands";

const heroDownload = heroDownloadTarget(undefined, undefined);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead />
		<title>RealThing — a fast, modern developer IDE for Git worktrees and diff review</title>
		<meta
			name="description"
			content="Open a repo as a project, cut isolated git-worktree workspaces, and work in a fast, modern developer IDE — Monaco editor tabs, integrated terminals, multi-scope diff review, and workspace plans. Open source, Apache-2.0, a JetBrains InnovationHub project."
		/>
		<link rel="canonical" href="https://realthing.ai/" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="RealThing — a fast, modern developer IDE for Git worktrees and diff review" />
		<meta
			property="og:description"
			content="Git-worktree workspaces, Monaco editor tabs, integrated terminals, multi-scope diff review, and workspace plans. Open source, Apache-2.0."
		/>
		<meta property="og:url" content="https://realthing.ai/" />
		<meta property="og:image" content="https://realthing.ai/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="alternate" type="application/rss+xml" title="RealThing Blog" href="/blog/rss.xml" />
	</head>
	<body>
		<IdeShell workspace="website" nav="landing" skipHref="#readme">
			<nav class="tabstrip" aria-label="Editor tabs"></nav>

			<main class="editor" id="editor-scroll" aria-label="Page content">
				<!-- ── README.md ─ hero ── -->
				<section class="file-section hero" id="readme" data-file="README.md">
					<p class="file-comment">&lt;!-- README.md --&gt;</p>
					<p class="hero-kicker">
						<span class="pill pill-accent">JetBrains InnovationHub</span>
						<span class="pill">Apache-2.0</span>
						<span class="pill">open source</span>
					</p>
					<h1 class="hero-title">RealThing</h1>
					<p class="hero-tagline">A fast, modern developer IDE for Git worktrees and multi-scope diff review.</p>
					<p class="hero-lede">
						Open a repo as a project. Cut isolated <strong>git-worktree workspaces</strong>. Edit
						code across Monaco tabs, integrated terminals, multi-scope diff review, and
						<strong>workspace plans</strong>.
					</p>
					<div class="send-link" data-send-link hidden>
						<button type="button" class="btn btn-primary send-link-btn" data-share-install-link="readme">
							<span class="send-link-label">Send link to my computer</span>
							<span class="send-link-done" aria-live="polite">Link copied</span>
						</button>
						<p class="send-link-note">RealThing runs on macOS, Windows, and Linux.</p>
					</div>
					<div class="hero-ctas">
						<div class="hero-download">
							<a
								class="btn btn-primary"
								href={heroDownload.href}
								data-hero-download
								aria-label={heroDownload.ariaLabel}
							>
								<svg class="i" aria-hidden="true"><use href="#i-download" /></svg>
								<span data-hero-download-label>{heroDownload.label}</span>
							</a>
							<a class="hero-download-other" href="#install">
								Other platforms & CLI
								<svg class="i" aria-hidden="true"><use href="#i-chevron-down" /></svg>
							</a>
						</div>
						<a class="btn" href="https://github.com/JetBrains/realthing" target="_blank" rel="noopener noreferrer">
							<svg class="i i-fill" aria-hidden="true"><use href="#i-github" /></svg>
							View on GitHub
							<span class="gh-stars" hidden title="GitHub stars">
								<svg class="i" aria-hidden="true"><use href="#i-star" /></svg>
								<span data-gh-stars-count></span>
								<span class="visually-hidden"> stars</span>
							</span>
						</a>
						<a class="btn" href="https://realthing.ai/discord" target="_blank" rel="noopener noreferrer">
							<svg class="i i-fill" aria-hidden="true"><use href="#i-discord" /></svg>
							Join our Discord
						</a>
					</div>
				</section>

				<!-- ── why.md ── -->
				<section class="file-section" id="why" data-file="why.md">
					<p class="file-comment">&lt;!-- WHY RealThing --&gt;</p>
					<h2>Why RealThing</h2>
					<div class="beats">
						<div class="beat">
							<h3>Tasks deserve worktrees, not your working tree.</h3>
							<p>
								Every workspace is a real <code>git worktree</code> — its own branch, its own
								cwd. Work on several features in parallel; each branch stays isolated, and
								<code>main</code> stays clean until you say otherwise.
							</p>
						</div>
						<div class="beat">
							<h3>Specs and workspace plans stay beside the code.</h3>
							<p>
								RealThing is built spec-first, and so are your projects: a connected graph of
								spec files and workspace plans lives beside the code so architectural intent
								and task progress stay clear.
							</p>
						</div>
						<div class="beat">
							<h3>A thin host, a fast native UI.</h3>
							<p>
								A lightweight local host manages Git worktrees, PTY terminals, and multi-scope
								diffs. RealThing owns the workspace, the editor, and the wire.
							</p>
						</div>
					</div>
				</section>

				<!-- ── features/worktrees.md ── -->
				<section class="file-section" id="worktrees" data-file="features/worktrees.md">
					<p class="file-comment">&lt;!-- FEATURES / worktrees --&gt;</p>
					<h2>Projects &rarr; workspaces</h2>
					<p>
						A project is any local git repo. A workspace is a <code>git worktree</code> cut from
						it — created in one click, listed in the rail, disposable without ceremony.
					</p>
					<pre class="code-block"><code><span class="sx-cm"># one repo, three parallel lines of thought</span>
~/code/my-repo                        <span class="sx-cm">← project</span>
└─ ~/.realthing/worktrees/
   ├─ workspace-1   <span class="sx-str">⎇ feature/auth</span>      <span class="sx-cm">feature branch</span>
   ├─ workspace-2   <span class="sx-str">⎇ fix/flaky-test</span>    <span class="sx-cm">bugfix branch</span>
   └─ workspace-3   <span class="sx-str">⎇ spike/ideas</span>       <span class="sx-cm">you, exploring</span></code></pre>
					<ul>
						<li>Own branch + cwd per workspace — files, diffs, terminals, and plans all scope to it.</li>
						<li>Switch workspaces instantly; nothing reloads, nothing leaks across.</li>
						<li>Merge the good one, delete the rest. Your repo never noticed the chaos.</li>
					</ul>
				</section>

				<!-- ── features/editor.md ── -->
				<section class="file-section" id="editor" data-file="features/editor.md">
					<p class="file-comment">&lt;!-- FEATURES / editor --&gt;</p>
					<h2>A fast, modern developer IDE</h2>
					<p>Edit code, review multi-scope diffs, and run terminals without leaving the workspace.</p>
					<div class="feature-grid">
						<div class="feature-card">
							<h3><svg class="i" aria-hidden="true"><use href="#i-panels-top-left" /></svg> Monaco editor tabs</h3>
							<p>The VS Code editor engine: syntax everywhere, rendered markdown with a source toggle, file tabs per workspace.</p>
						</div>
						<div class="feature-card">
							<h3><svg class="i" aria-hidden="true"><use href="#i-folder-tree" /></svg> Files tree</h3>
							<p>The active worktree at a glance — like the rail on the right of this very page.</p>
						</div>
						<div class="feature-card">
							<h3><svg class="i" aria-hidden="true"><use href="#i-git-branch-plus" /></svg> Changes</h3>
							<p>A live multi-scope git diff of the workspace branch, uncommitted work, and individual commits.</p>
						</div>
						<div class="feature-card">
							<h3><svg class="i" aria-hidden="true"><use href="#i-square-terminal" /></svg> Terminals</h3>
							<p>Real PTYs scoped to the worktree — run builds and tests right beside your editor tabs.</p>
						</div>
					</div>
				</section>

				<!-- ── features/agent-chat.md ── -->
				<section class="file-section" id="agent-chat" data-file="features/agent-chat.md">
					<p class="file-comment">&lt;!-- FEATURES / architecture --&gt;</p>
					<h2>Three-ring architecture</h2>
					<p>
						RealThing separates the local workspace host, typed protocol wire, and UI client:
					</p>
					<div class="chat-demo" id="chat-demo">
						<div class="chat-msg user" data-step>
							Quick tour: what is RealThing, and what are the three rings of its architecture?
							Keep it brief.
						</div>
						<div class="chat-activity" data-step>
							<svg class="i" aria-hidden="true"><use href="#i-check" /></svg>
							<span>read <code>goal-and-requirements.md</code> · <code>architecture.md</code></span>
						</div>
						<div class="chat-msg assistant">
							<p data-step>
								RealThing is a fast, modern developer IDE for code editing, Git worktrees,
								multi-scope diff review, integrated terminal, and workspace plans.
							</p>
							<p data-step>The <strong>three rings</strong>:</p>
							<ol>
								<li data-step>
									<strong>Workspace host</strong> (<code>packages/server</code>) —
									<code>createServer()</code> runs an HTTP+WS host managing worktrees,
									files, diffs, and PTY terminals.
								</li>
								<li data-step>
									<strong>The wire</strong> (<code>packages/contracts</code>) — the typed,
									versioned protocol between host and UI. Types only.
								</li>
								<li data-step>
									<strong>UI client</strong> (<code>apps/web</code>) — fast React workbench that
									ships independently and connects to the host over the wire.
								</li>
							</ol>
						</div>
						<div class="chat-done" data-step>
							<span><svg class="i" aria-hidden="true"><use href="#i-check" /></svg> Done</span>
							<span>3 rings · typed wire</span>
						</div>
					</div>
					<ul>
						<li>Multiple workspaces per project, each on its own Git worktree.</li>
						<li>Multi-scope diff review across branch, uncommitted, and commit scopes.</li>
						<li>Integrated PTY terminals scoped to each workspace directory.</li>
						<li>Workspace plans and specs to organize tasks alongside your code.</li>
					</ul>
				</section>

				<!-- ── features/specs.md ── -->
				<section class="file-section" id="specs" data-file="features/specs.md">
					<p class="file-comment">&lt;!-- FEATURES / specs --&gt;</p>
					<h2>Specs are first-class</h2>
					<p>
						Every module carries a <code>SPEC.md</code> with frontmatter linking it into a graph —
						goal, architecture, modules, tasks:
					</p>
					<div class="spec-tree">
						<div class="spec-row depth-0">
							<svg class="i" aria-hidden="true"><use href="#i-book" /></svg>
							<span>RealThing — product goal and scope</span>
							<b class="spec-badge badge-accent">main spec</b>
						</div>
						<div class="spec-row depth-1">
							<svg class="i" aria-hidden="true"><use href="#i-fork" /></svg>
							<span>RealThing — top-level architecture</span>
							<b class="spec-badge">arch</b>
						</div>
						<div class="spec-row depth-2">
							<svg class="i" aria-hidden="true"><use href="#i-box" /></svg>
							<span>Workspace host (server library)</span>
							<b class="spec-badge">module</b>
						</div>
						<div class="spec-row depth-3">
							<svg class="i" aria-hidden="true"><use href="#i-box" /></svg>
							<span>workspaces — git worktree management</span>
							<b class="spec-badge">submodule</b>
						</div>
						<div class="spec-row depth-2">
							<svg class="i" aria-hidden="true"><use href="#i-box" /></svg>
							<span>Web UI client</span>
							<b class="spec-badge">module</b>
						</div>
					</div>
					<pre class="code-block"><code><span class="sx-punct">---</span>
<span class="sx-prop">id:</span> <span class="sx-str">module-server</span>
<span class="sx-prop">type:</span> <span class="sx-str">module-design</span>
<span class="sx-prop">status:</span> <span class="sx-str">active</span>
<span class="sx-prop">parent:</span> <span class="sx-str">architecture</span>
<span class="sx-punct">---</span></code></pre>
					<p>
						Plain markdown, plain frontmatter, versioned with the code — reading the specs is
						enough to understand an area and formulate the next task.
					</p>
				</section>

				<section class="file-section" id="install" data-file="INSTALL.md">
					<p class="file-comment">&lt;!-- INSTALL.md --&gt;</p>
					<h2>Install</h2>
					<p>Choose your platform and start working.</p>
					<div class="desktop-download-list">
						{desktopInstallerPlatforms.map((installer) => (
							<div class="desktop-download-row" data-desktop-platform={installer.id}>
								<div class="desktop-download-row-label">
									<strong class="desktop-download-platform">{installer.label}</strong>
									<span class="desktop-download-compatibility">{installer.detail}</span>
								</div>
								<div class="desktop-download-row-actions">
									{installer.downloads.map((download) => (
										<a class="btn btn-primary" href={download.href} aria-label={`${download.label} for ${installer.label}: ${installer.detail}`}>{download.label} ↓</a>
									))}
								</div>
							</div>
						))}
					</div>
					<p class="install-linux-note">Linux: extract the archive, run <code>./installer</code>, and check the <a href="https://github.com/JetBrains/realthing#install">native library requirements</a>.</p>
					<h3 class="install-cli-heading">Browser UI via command line</h3>
					<p class="browser-ui-note">Install the local launcher, then run <code>realthing</code> to open the browser UI.</p>
					<CliInstall />
					<p class="install-fineprint">Requires <code>git</code>. See <a href="https://github.com/JetBrains/realthing/releases">all releases</a> and <a href="https://github.com/JetBrains/realthing#install">advanced CLI options</a>.</p>
				</section>

				<!-- ── CONTRIBUTING.md ─ footer ── -->
				<section class="file-section footer-section" id="contributing" data-file="CONTRIBUTING.md">
					<p class="file-comment">&lt;!-- CONTRIBUTING --&gt;</p>
					<h2>Open source, spec-first</h2>
					<p>
						RealThing is a <a href="https://github.com/JetBrains">JetBrains</a> InnovationHub project,
						licensed <a href="https://github.com/JetBrains/realthing/blob/main/LICENSE">Apache-2.0</a>.
						The repo is developed spec-first — the top-level specs are the product's ground truth,
						and this website is itself a module with a <code>SPEC.md</code>.
					</p>
					<nav class="footer-links" aria-label="Project links">
						<a href="https://github.com/JetBrains/realthing"><svg class="i i-fill" aria-hidden="true"><use href="#i-github" /></svg>GitHub</a>
						<a href="https://realthing.ai/discord"><svg class="i i-fill" aria-hidden="true"><use href="#i-discord" /></svg>Discord</a>
						<a href="https://github.com/JetBrains/realthing/issues"><svg class="i" aria-hidden="true"><use href="#i-bug" /></svg>Issues</a>
						<a href="https://github.com/JetBrains/realthing/blob/main/CONTRIBUTING.md"><svg class="i" aria-hidden="true"><use href="#i-git-pull-request" /></svg>Contributing</a>
						<a href="https://github.com/JetBrains/realthing/blob/main/CODE_OF_CONDUCT.md"><svg class="i" aria-hidden="true"><use href="#i-scale" /></svg>Code of Conduct</a>
						<a href="https://github.com/JetBrains/realthing/releases"><svg class="i" aria-hidden="true"><use href="#i-package" /></svg>Releases</a>
					</nav>
				</section>
			</main>

			<Fragment slot="filetree">
				<a class="ft-row file" href="#readme"><svg class="i" aria-hidden="true"><use href="#i-file" /></svg>README.md</a>
				<a class="ft-row file depth-1" href="#why"><svg class="i" aria-hidden="true"><use href="#i-circle-help" /></svg>WHY RealThing</a>
				<a class="ft-row file depth-1" href="#worktrees"><svg class="i" aria-hidden="true"><use href="#i-blocks" /></svg>FEATURES</a>
				<a class="ft-row file depth-2" href="#worktrees"><svg class="i" aria-hidden="true"><use href="#i-git-branch" /></svg>worktrees</a>
				<a class="ft-row file depth-2" href="#editor"><svg class="i" aria-hidden="true"><use href="#i-square-pen" /></svg>editor</a>
				<a class="ft-row file depth-2" href="#agent-chat"><svg class="i" aria-hidden="true"><use href="#i-message-square" /></svg>agent-chat</a>
				<a class="ft-row file depth-2" href="#specs"><svg class="i" aria-hidden="true"><use href="#i-file-text" /></svg>specs</a>
				<a class="ft-row file depth-1" href="#install"><svg class="i" aria-hidden="true"><use href="#i-package" /></svg>INSTALL.md</a>
				<a class="ft-row file depth-1" href="#contributing"><svg class="i" aria-hidden="true"><use href="#i-git-pull-request" /></svg>CONTRIBUTING</a>
			</Fragment>
		</IdeShell>
	</body>
</html>
